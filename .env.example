# ==========================================
# The Growth Inc. — Environment Configuration Example
# Copy this file to .env.local and update the values
# ==========================================

# 1. Calendly Event Link (e.g. https://calendly.com/your-username/30min)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min

# 2. Contact / Notification Email (Inquiry forms will be sent TO this email)
NEXT_PUBLIC_CONTACT_EMAIL=thegrowthincc@gmail.com
CONTACT_EMAIL=thegrowthincc@gmail.com

# 3. Company Name
NEXT_PUBLIC_COMPANY_NAME=The Growth Inc.

# 4. Email Sending Service (Option A: Resend — Recommended for Vercel, free 3,000 emails/mo)
# Get a free API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Growth Inc. <onboarding@resend.dev>

# (Option B: Alternative SMTP / Gmail App Password)
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password
